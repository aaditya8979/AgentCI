# =============================================================================
# AgentCI Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#
#   cp .env.example .env
#   # Edit .env with your actual values
#
# Variables marked [REQUIRED] must be set before starting.
# Variables with defaults can be omitted.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Docker Compose uses agentci_dev as password.
DATABASE_URL=postgresql://agentci:agentci_dev@localhost:5432/agentci

# ── Redis ───────────────────────────────────────────────────────────────────
# Redis for pub/sub (live progress), rate limiting, and eval caching.
REDIS_URL=redis://localhost:6379

# ── Temporal ────────────────────────────────────────────────────────────────
# Temporal server for workflow orchestration.
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agentci-eval

# ── GitHub App [REQUIRED for webhook integration] ───────────────────────────
# 1. Create a GitHub App at https://github.com/settings/apps/new
# 2. Set Webhook URL to your ngrok URL: https://xxxx.ngrok-free.app/webhook/github
# 3. Generate a random webhook secret: openssl rand -hex 20
# 4. After creating, note the App ID, generate a Private Key, and install on your repo.
#
# Webhook secret — must match what you set in the GitHub App settings.
# Generate with: openssl rand -hex 20
GITHUB_WEBHOOK_SECRET=generate-with-openssl-rand-hex-20

# GitHub App credentials — fill these in after creating the app.
# GITHUB_APP_ID=123456
# GITHUB_INSTALLATION_ID=12345678
# For the private key, replace newlines with \n:
#   awk 'NF {sub(/\r/, ""); printf "%s\\n", $0}' your-app.private-key.pem
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# ── Authentication [REQUIRED] ───────────────────────────────────────────────
# Comma-separated API keys for /api/* endpoints and the dashboard login.
# Use any strong random string. Multiple keys supported for key rotation.
AGENTCI_API_KEYS=your-api-key-here

# ── LLM Judge API Keys [at least one REQUIRED] ─────────────────────────────
# The judge panel needs LLM API access. Set at least one provider.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...

# ── Ollama (Optional — for local/free judge models) ─────────────────────────
# OLLAMA_HOST=http://localhost:11434

# ── Logging ─────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Log format: "json" for production, "console" for development
LOG_FORMAT=console

# ── Rate Limiting ───────────────────────────────────────────────────────────
# Maximum webhook-triggered eval runs per repository per hour.
AGENTCI_RATE_LIMIT=20

# ── Dashboard CORS ──────────────────────────────────────────────────────────
# Origin URL for CORS. Set to your dashboard's public URL in production.
DASHBOARD_ORIGIN=http://localhost:3000
